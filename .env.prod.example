# Modelo do .env de PRODUÇÃO usado pelo docker-compose.prod.yml.
# Copie para `.env.prod` e preencha com valores reais. NUNCA commitar
# o .env.prod (ele está coberto por .env.* no .gitignore).

# Gere uma chave forte, ex.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-aleatoria-forte

# Em produção SEMPRE False.
DEBUG=False

# Domínios que servem a aplicação (sem http://). Ex.: diario.suaescola.com.br
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis pro CSRF — COM esquema (https://). Obrigatório pro
# admin funcionar atrás de proxy. Ex.: https://diario.onrender.com
CSRF_TRUSTED_ORIGINS=https://localhost

# Ative quando houver HTTPS de verdade na frente (Render, domínio com TLS):
# liga redirect pra https + cookies "secure" (sessão e CSRF). Deixe False
# (ou omita) ao testar o compose de produção localmente em http puro.
SECURE_SSL=False

# Banco — DB_HOST é sobrescrito para `db` pelo compose, mas mantenha as
# credenciais coerentes (o serviço `db` usa estas mesmas variáveis).
DB_NAME=diario_escolar
DB_USER=diario
DB_PASSWORD=troque-por-uma-senha-forte
DB_HOST=db
DB_PORT=5432

# Origens permitidas pro CORS. Em produção o frontend é servido pela
# mesma origem (nginx), então normalmente é só o domínio público.
CORS_ALLOWED_ORIGINS=http://localhost

# Concorrência do gunicorn. Defaults (1 worker + 4 threads, gthread) cabem
# em free tier de 256-512 MB. Em servidor maior (VPS com vários GB), suba
# os workers: a regra clássica é (2 x núcleos) + 1.
#   GUNICORN_WORKERS=3
#   GUNICORN_THREADS=4
#   GUNICORN_WORKER_CLASS=gthread

# Email — notifica o responsável quando uma ocorrência é criada. Sem estas
# variáveis, o backend usa o console backend (não envia de verdade).
#
# Em produção no Render free, SMTP é bloqueado nas portas 25/465/587 desde
# set/2025 — então usamos a API HTTP do Brevo via `django-anymail` (porta
# 443, sempre liberada). Crie conta em brevo.com, gere uma "v3 API key" e
# cole abaixo. Não exige domínio próprio: basta verificar o endereço
# remetente em "Senders, Domains & Dedicated IPs → Senders".
EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
ANYMAIL_BREVO_API_KEY=xkeysib-sua_api_key_do_brevo
DEFAULT_FROM_EMAIL=Diário Escolar <seu-email-verificado@gmail.com>

# Legado: variáveis SMTP. Ficam aqui caso algum provedor (ou plano pago do
# Render) libere SMTP outbound de novo. Em produção via Brevo (acima) elas
# são ignoradas.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Observabilidade — Sentry. Sem SENTRY_DSN o SDK fica inerte (bom pra dev
# local). Em produção, crie projeto Django em sentry.io e cole o DSN aqui.
# SENTRY_ENVIRONMENT controla a tag (production/staging/dev) — pra separar
# erros por ambiente no painel.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Sentry Tunnel — proxy `/api/v1/_sentry/` que reencaminha envelopes do
# frontend pro Sentry. Necessário porque adblockers (Opera, uBlock, Brave)
# bloqueiam *.ingest.sentry.io direto. Whitelist obrigatória pra evitar
# virar relay aberto:
# - SENTRY_TUNNEL_HOST: host único do Sentry (extraído da DSN do frontend)
# - SENTRY_TUNNEL_PROJECT_IDS: CSV de project_ids permitidos
# Exemplo:
#   SENTRY_TUNNEL_HOST=o4511493890572288.ingest.us.sentry.io
#   SENTRY_TUNNEL_PROJECT_IDS=4511493892210688
# Sem ambos setados, o endpoint responde 503 (proxy desligado).
SENTRY_TUNNEL_HOST=
SENTRY_TUNNEL_PROJECT_IDS=
